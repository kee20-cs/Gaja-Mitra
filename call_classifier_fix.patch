+    if energy_ratio_mid > 0.55:
+        confidence = 0.55
+        if energy_ratio_mid > 0.6:
+            confidence += 0.15
+        if energy_ratio_mid > 0.75:
+            confidence += 0.15
+        if snr > 15:
+            confidence += 0.05
+        return {"call_type": "roar", "confidence": round(min(confidence, 1.0), 3)}
 
